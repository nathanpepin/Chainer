        }
      },
      {
        "HandlerTypeName": "FileHandlerRemoveComma"
      },
      {
        "HandlerTypeName": "FileHandlerIsLegit",
        "Configuration": {
          "RequiredText": "legit",
          "CaseSensitive": false
        }
      }
    ]
  },
  "FileProcessingChain2": {
